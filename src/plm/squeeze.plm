/*
 * squeeze.plm - Squeeze Decompression (Huffman + RLE)
 *
 * Decompresses .?Q? files (USQ format)
 */

declare cpm$eof literally '01AH';

/* External declarations */
declare huff$tree$ptr address external;
declare huff$tree based huff$tree$ptr (1) byte;
declare huff$nodes address external;
declare bits$left byte external;
declare input$short byte external;

/* Procedures from common.plm and io.plm - visible when compiled together */

/*========================================================
 * Squeeze Decompression
 *========================================================*/

unsqueeze: procedure byte public;
    declare msg$sqtree data('Bad Huffman tree$');
    declare b byte;
    declare i address;
    declare (node$count, node, left, symbol) address;
    declare p address;
    declare done byte;
    declare (lo$byte, hi$byte) byte;

    /* Magic already verified, skip it */
    b = getbyte;  /* 76 */
    b = getbyte;  /* FF */

    /* Read checksum (ignored) */
    lo$byte = getbyte;
    hi$byte = getbyte;

    /* Skip original filename (null-terminated) */
    do while (b := getbyte) <> 0 and b <> cpm$eof;
    end;

    /* Read node count */
    lo$byte = getbyte;
    hi$byte = getbyte;
    node$count = lo$byte + shl(double(hi$byte), 8);

    if node$count > 256 then do;
        call printstr(.msg$sqtree);
        call printchar(' ');
        call printhex(high(node$count));
        call printhex(low(node$count));
        return 0;
    end;

    /* Read Huffman tree nodes.  A file that uses every byte value has 257
       symbols with the end code, and so 256 nodes: I counts in 16 bits,
       because LOW(256) is 0 and the tree used to be read as empty, which
       left the decoder walking stale nodes for ever. */
    i = 0;
    do while i < node$count;
        p = huff$tree$ptr + shl(i, 2);
        huff$tree(p - huff$tree$ptr) = getbyte;
        huff$tree(p - huff$tree$ptr + 1) = getbyte;
        huff$tree(p - huff$tree$ptr + 2) = getbyte;
        huff$tree(p - huff$tree$ptr + 3) = getbyte;
        i = i + 1;
    end;

    huff$nodes = node$count;

    /* An empty file has no symbol but the end code, and SQ writes it as a
       tree of no nodes followed by no code bits (USQ makes both children of
       its node 0 the end code for it).  There is nothing to write.  The loop
       below reads a bit only inside a node, so with no nodes it read none,
       and went round for ever. */
    if node$count = 0 then return 1;

    /* Initialize bit reader and RLE decoder */
    call init$bits$lsb;
    call init$rle;

    /* Decode symbols.  A Huffman code can be a single bit, so the byte that
       holds the end of the input can hold whole symbols after the one that
       fetched it: go on while bits are left, and stop at the first bit read
       from past the end of the input (INPUT$SHORT), leaf or not, rather than
       write the symbol it belongs to.  Stopping there and not only at a leaf
       also ends a tree whose nodes lead back to one another, which never
       reaches a leaf and used to read on for ever. */
    done = 0;
    input$short = 0;
    do while done = 0 and (bits$left <> 0 or input$avail <> 0);
        node = 0;
        do while node < huff$nodes;
            p = huff$tree$ptr + shl(double(low(node)), 2);
            if read$bit$lsb then
                left = readword(p + 2);
            else
                left = readword(p);

            if input$short then do;
                done = 1;
                node = huff$nodes;
            end;
            else if (left and 8000h) <> 0 then do;
                symbol = (not left);
                if symbol = 256 then do;
                    done = 1;
                end;
                else do;
                    if rle$decode$byte(low(symbol)) = 0 then
                        return 0;
                end;
                node = huff$nodes;
            end;
            else if left < huff$nodes then do;
                node = left;
            end;
            else do;
                /* A child past the tree: nothing after it can be decoded.
                   Going back to the root and on, as this did, wrote
                   whatever the rest of the bits made; src/un80 stops. */
                done = 1;
                node = huff$nodes;
            end;
        end;
    end;

    return 1;
end unsqueeze;

eof
