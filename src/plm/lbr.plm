/*
 * lbr.plm - LBR Archive Extractor
 *
 * Extracts files from LBR (Library) archives
 */

declare cpm$eof literally '01AH';
declare magic$sq$lo literally '0FFH';
declare magic$sq$hi literally '076H';
declare magic$cr$lo literally '0FEH';
declare magic$cr$hi literally '076H';
declare magic$lzh$lo literally '0FDH';
declare magic$lzh$hi literally '076H';

/* External declarations */
declare fcb$ptr address external;
declare fcb based fcb$ptr (36) byte;
declare ifcb$ptr address external;
declare ifcb based ifcb$ptr (36) byte;
declare ofcb$ptr address external;
declare ofcb based ofcb$ptr (36) byte;
declare dma$ptr address external;
declare dma based dma$ptr (128) byte;
declare inbuf$ptr address external;
declare inbuf based inbuf$ptr (1) byte;
declare inbuf$pos address external;
declare inbuf$end address external;
declare outbuf$pos address external;
declare file$count address external;

/* Procedures from earlier modules - visible when compiled together */

/*========================================================
 * LBR Archive Extraction
 *========================================================*/

/* External for directory buffer */
declare work$ptr address external;
declare work based work$ptr (1) byte;

/* Extract files from LBR archive */
extract$lbr: procedure byte public;
    declare msg$badlbr data('Invalid LBR file$');
    declare msg$nocreat data(' - cannot create$');
    declare msg$ok data(' OK$');
    declare msg$error data(13, 10, '  Error$');

    declare saved$fcb (36) byte;
    declare member$name (12) byte;
    declare (n, m) byte;

    declare result byte;
    declare dir$sectors byte;
    declare k byte;
    declare entry$num address;
    declare max$entries address;
    declare sectors$left address;
    declare member$index address;
    declare member$length address;

    /* Pointers for directory entries - use work buffer for directory */
    declare dir$ptr address;
    declare ent$ptr address;
    declare ent based ent$ptr (32) byte;

    /* Read directory into work buffer (up to 32 sectors = 4K) */
    dir$ptr = work$ptr;
    inbuf$pos = 0;
    inbuf$end = 0;
    call clear$input$limit;  /* No limit while reading the directory */

    /* Read first sector to get directory size */
    call setdmaaddr(dir$ptr);
    if readfile(ifcb$ptr) <> 0 then do;
        call printstr(.msg$badlbr);
        return 0;
    end;

    /* Check first entry (directory itself) */
    ent$ptr = dir$ptr;
    if ent(0) <> 0 then do;
        call printstr(.msg$badlbr);
        return 0;
    end;

    /* Get directory size in sectors.  It is 16 bits, like every length in
       the directory, and only its low byte was read: a directory of 260
       (0104H) sectors was taken as 4, and only the members in its first four
       sectors were extracted, with nothing said.  WORK holds 32 sectors,
       128 entries; a directory of none or of more than that, a high byte
       other than 0 among them, is refused, as src/un80 refuses it ("Invalid
       directory size"), and nothing is extracted. */
    dir$sectors = ent(14);
    if ent(15) <> 0 then dir$sectors = 0;
    if dir$sectors = 0 or dir$sectors > 32 then do;
        call printstr(.msg$badlbr);
        return 0;
    end;

    /* Read remaining directory sectors into work buffer.  A file that ends
       inside its directory has only the sectors read: the entries past them
       used to be taken from whatever WORK held before, which made members
       called UNNAMED out of nothing.  src/un80 stops at the same place. */
    k = 1;
    do while k < dir$sectors;
        call setdmaaddr(dir$ptr + shl(double(k), 7));  /* k * 128 */
        if readfile(ifcb$ptr) <> 0 then
            dir$sectors = k;  /* Exit on error */
        else
            k = k + 1;
    end;

    max$entries = shl(dir$sectors, 2);

    /* Save the original FCB for reopening */
    call copymem(fcb$ptr, .saved$fcb, 12);
    call fillmem(.saved$fcb(12), 24, 0);

    file$count = 0;
    entry$num = 1;

    do while entry$num < max$entries;
        ent$ptr = dir$ptr + shl(entry$num, 5);  /* entry_num * 32 */

        do;
            if ent(0) = 0ffh then do;
                entry$num = max$entries;
            end;
            else if ent(0) = 0 then do;
                /* Active entry */
                call printchar(' ');
                call printchar(' ');

                /* The member's name, NAME.TYP without the blanks that pad
                   the directory fields, and print it */
                n = 0;
                m = 0;
                k = 1;
                do while k <= 8;
                    member$name(n) = ent(k) and 07fh;
                    n = n + 1;
                    if member$name(n - 1) <> ' ' then m = n;
                    k = k + 1;
                end;
                n = m;
                k = 9;
                do while k <= 11;
                    if (ent(k) and 07fh) <> ' ' then m = k;
                    k = k + 1;
                end;
                if m >= 9 then do;
                    member$name(n) = '.';
                    n = n + 1;
                    k = 9;
                    do while k <= m;
                        member$name(n) = ent(k) and 07fh;
                        n = n + 1;
                        k = k + 1;
                    end;
                end;
                k = 0;
                do while k < n;
                    call printchar(member$name(k));
                    k = k + 1;
                end;

                /* Save member info */
                member$index = ent(12) + shl(double(ent(13)), 8);
                member$length = ent(14) + shl(double(ent(15)), 8);

                /* Set up output FCB.  An LBR directory entry is arbitrary
                   bytes, and CP/M refuses a name that holds a delimiter, so
                   cpm$name (names.plm) makes one it takes: mouse.lbr carries
                   CCP/M.COM and CCP/M.LTR, which come out as CCP-M.COM and
                   CCP-M.LTR. */
                call cpm$name(.member$name, n);

                if member$length <> 0 then do;
                    call deletefile(ofcb$ptr);
                    result = makefile(ofcb$ptr);
                    if result = 0ffh then do;
                        call printstr(.msg$nocreat);
                        call crlf;
                    end;
                    else do;
                        /* Reopen input file */
                        call closefile(ifcb$ptr);
                        call copymem(.saved$fcb, ifcb$ptr, 12);
                        call fillmem(ifcb$ptr + 12, 24, 0);

                        /* A member says OK and is counted when RESULT is 1:
                           its decoder, or the copy of a stored member, came
                           to its end and its file took all it was given.
                           Anything else is an Error, and the next member is
                           gone on to, as in an ARC (extract$arc$member): a
                           decoder that fails (a squeeze tree of more than 256
                           nodes, a Crunch V1 siglevel refused, V1 input that
                           ends before its end code), a stored member whose
                           sectors are not all in the file, a file that will
                           not take the member, an archive that will not
                           reopen.  It used to say OK and be counted whatever
                           became of it.

                           OK is not a member come out whole.  Of the
                           compressed ones only Crunch V1 finds a member cut
                           short.  The squeeze and Crunch V2 decoders stop
                           where the sectors in the file end, and the member
                           says OK with what those decode to, the bytes
                           src/un80 writes.  CrLZH decodes on past the end,
                           from the ^Z getbyte gives there, until they happen
                           to make its stop code; src/un80 decodes on from
                           zero bits, so the two write different bytes after
                           the data in the file. */
                        result = 0;
                        if openfile(ifcb$ptr) <> 0ffh then do;
                            /* Skip to member */
                            call setdmaaddr(dma$ptr);
                            sectors$left = member$index;
                            do while sectors$left <> 0;
                                result = readfile(ifcb$ptr);
                                sectors$left = sectors$left - 1;
                            end;
                            result = 0;

                            /* A compressed member is decoded through getbyte,
                               which now stops at the member's end rather than
                               reading on into the next member.  The length is
                               in 128-byte sectors, up to 65535 of them, so the
                               limit in bytes takes 23 bits. */
                            inbuf$pos = 0;
                            inbuf$end = 0;
                            outbuf$pos = 0;
                            call set$input$limit(shl(member$length, 7),
                                                 shr(member$length, 9));
                            if fill$inbuf <> 0 then do;
                                if inbuf(0) = magic$sq$hi and inbuf(1) = magic$sq$lo then
                                    result = unsqueeze;
                                else if inbuf(0) = magic$cr$hi and inbuf(1) = magic$cr$lo then
                                    result = uncrunch;
                                else if inbuf(0) = magic$lzh$hi and inbuf(1) = magic$lzh$lo then
                                    result = uncrlzh;
                                else do;
                                    /* Stored: copied a sector at a time.  A
                                       sector past the end of the file ends
                                       it, where the one before was written
                                       again in its place, and so does one
                                       the disk will not take. */
                                    result = 1;
                                    sectors$left = member$length;
                                    do while sectors$left <> 0;
                                        call setdmaaddr(dma$ptr);
                                        if inbuf$pos < inbuf$end then do;
                                            call copymem(inbuf$ptr + inbuf$pos, dma$ptr, 128);
                                            inbuf$pos = inbuf$pos + 128;
                                        end;
                                        else if readfile(ifcb$ptr) <> 0 then
                                            result = 0;
                                        if result then do;
                                            if writefile(ofcb$ptr) <> 0 then result = 0;
                                        end;
                                        sectors$left = sectors$left - 1;
                                        if result = 0 then sectors$left = 0;
                                    end;
                                end;
                                /* A decoder that fails leaves its last part
                                   record unwritten: the file holds the whole
                                   128-byte records decoded before the error,
                                   none for a Huffman tree of more than 256
                                   nodes or a crunch siglevel refused, which
                                   fail before a byte is decoded.  src/un80
                                   writes the member's stored sectors
                                   instead. */
                                if result then result = flush$outbuf;
                            end;
                            call clear$input$limit;

                            /* Directory already in work buffer - just close input */
                            call closefile(ifcb$ptr);
                        end;
                        call closefile(ofcb$ptr);

                        if result then do;
                            file$count = file$count + 1;
                            call printstr(.msg$ok);
                        end;
                        else
                            call printstr(.msg$error);
                        call crlf;
                    end;
                end;
                else do;
                    /* A member of no sectors is an empty file: make it, as
                       src/un80 does.  It used to be left out while cpm$name
                       had taken its name all the same, so that a later member
                       of that name came out as NAME-1 with no NAME. */
                    call deletefile(ofcb$ptr);
                    if makefile(ofcb$ptr) = 0ffh then do;
                        call printstr(.msg$nocreat);
                    end;
                    else do;
                        call closefile(ofcb$ptr);
                        file$count = file$count + 1;
                        call printstr(.msg$ok);
                    end;
                    call crlf;
                end;

                entry$num = entry$num + 1;
            end;
            else do;
                /* Deleted entry, skip */
                entry$num = entry$num + 1;
            end;
        end;  /* do block */
    end;  /* while entry$num */

    return 1;
end extract$lbr;

eof
