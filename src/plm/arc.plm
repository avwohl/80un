/*
 * arc.plm - ARC Archive Extractor
 *
 * Extracts files from ARC archives (methods 1-9)
 */

declare cpm$eof literally '01AH';
declare arc$marker literally '01AH';
declare rle$marker literally '090H';

/* External declarations */
declare ofcb$ptr address external;
declare ofcb based ofcb$ptr (36) byte;
declare outbuf$pos address external;
declare file$count address external;
declare huff$tree$ptr address external;
declare huff$tree based huff$tree$ptr (1) byte;
declare huff$nodes address external;
declare bits$left byte external;
declare input$short byte external;
declare lzw$prefix$ptr address external;
declare lzw$suffix$ptr address external;
declare lzw$next$code address external;
declare lzw$code$size byte external;
declare lzw$max$bits byte external;

/* Procedures from earlier modules - visible when compiled together */

/* Raw LZW output without RLE (for method 9) */
lzw$output$raw: procedure(code) address external;
    declare code address;
end lzw$output$raw;

/*========================================================
 * ARC Decompression Methods
 *========================================================*/

/* ARC method 1/2: Stored (no compression).  The member's size, all 32 bits
   of it, is the input limit, so this copies until getbyte runs out. */
arc$decomp$stored: procedure byte;
    do while input$avail;
        if putbyte(getbyte) = 0 then return 0;
    end;
    return 1;
end arc$decomp$stored;

/* ARC method 3: RLE only.  It too runs to the end of the member's input: its
   size used to be passed in as the low 16 bits of the compressed size. */
arc$decomp$rle: procedure byte;
    declare (b, cnt, prev) byte;

    prev = 0;
    do while input$avail;
        b = getbyte;

        if b = rle$marker then do;
            /* A marker with no count byte after it carries no data, so it is
               dropped - the same as rle$decode$byte and UNCR24 do */
            if input$avail then do;
                cnt = getbyte;
                if cnt = 0 then do;
                    /* Literal 090H; the previous byte is left alone */
                    if putbyte(rle$marker) = 0 then return 0;
                end;
                else do;
                    /* CNT counts the previous byte's TOTAL occurrences, and it
                       was already written once, so emit CNT-1 further copies */
                    cnt = cnt - 1;
                    do while cnt > 0;
                        if putbyte(prev) = 0 then return 0;
                        cnt = cnt - 1;
                    end;
                end;
            end;
        end;
        else do;
            if putbyte(b) = 0 then return 0;
            prev = b;
        end;
    end;
    return 1;
end arc$decomp$rle;

/* ARC method 4: Squeezed (Huffman + RLE) */
arc$decomp$squeezed: procedure byte;
    declare b byte;
    declare i address;
    declare (node$count, node, left, symbol) address;
    declare p address;
    declare done byte;

    /* Read node count */
    node$count = read$bits$lsb(16);
    if node$count > 256 then return 0;

    /* Read Huffman tree: up to 256 nodes, so I counts in 16 bits (see
       unsqueeze) */
    i = 0;
    do while i < node$count;
        p = huff$tree$ptr + shl(i, 2);
        /* Read left (16 bits) and right (16 bits) as signed */
        call writeword(p, read$bits$lsb(16));
        call writeword(p + 2, read$bits$lsb(16));
        i = i + 1;
    end;

    huff$nodes = node$count;

    /* An empty member: no nodes and no code bits, nothing to write.  The
       loop below would read no bit and never end.  See unsqueeze. */
    if node$count = 0 then return 1;
    call init$rle;

    /* Decode symbols.  The member's last byte can hold whole symbols after
       the one that fetched it, and the loop used to stop as soon as that byte
       was read, which dropped them: go on while bits are left, and stop at
       the first bit read from past the end of the member (INPUT$SHORT), leaf
       or not, which also ends a tree that never reaches a leaf.  See
       unsqueeze. */
    done = 0;
    input$short = 0;
    do while done = 0 and (bits$left <> 0 or input$avail <> 0);
        node = 0;
        do while node < huff$nodes;
            p = huff$tree$ptr + shl(double(low(node)), 2);
            if read$bit$lsb then
                left = readword(p + 2);
            else
                left = readword(p);

            if input$short then do;
                done = 1;
                node = huff$nodes;
            end;
            else if (left and 8000h) <> 0 then do;
                symbol = not left;
                if symbol = 256 then
                    done = 1;
                else do;
                    if rle$decode$byte(low(symbol)) = 0 then return 0;
                end;
                node = huff$nodes;
            end;
            else if left < huff$nodes then do;
                node = left;
            end;
            else do;
                /* A child past the tree: nothing after it can be decoded.
                   Going back to the root and on, as this did, wrote
                   whatever the rest of the bits made; src/un80 stops. */
                done = 1;
                node = huff$nodes;
            end;
        end;
    end;

    return 1;
end arc$decomp$squeezed;

/* ARC method 5/6: Old LZW (MSB first, 12-bit fixed) */
arc$decomp$lzw56: procedure(with$rle) byte;
    declare with$rle byte;
    declare (code, prev$code) address;
    declare (first$flag, done) byte;
    declare fb byte;

    call init$lzw;
    lzw$next$code = 256;  /* Old format starts at 256 */
    call init$bits$msb;
    /* Always reset the RLE state, even for method 5.  Leaving it alone let a
       half-finished escape from the previous member leak into this one. */
    call init$rle;

    prev$code = 0ffffh;
    first$flag = 1;
    done = 0;

    do while done = 0 and input$avail <> 0;
        code = read$code$msb(12);

        if code < 256 then do;
            if with$rle then do;
                if rle$decode$byte(low(code)) = 0 then return 0;
            end;
            else do;
                if putbyte(low(code)) = 0 then return 0;
            end;
            fb = low(code);
        end;
        else if code < lzw$next$code then do;
            fb = lzw$first$byte(code);
            /* Method 5 has no RLE layer, so its dictionary strings must go
               out raw.  Literals below already honour WITH$RLE; routing the
               strings through lzw$output regardless meant a 0x90 inside a
               dictionary string armed the escape and swallowed the next byte. */
            if with$rle then do;
                if lzw$output(code) = 0 then return 0;
            end;
            else do;
                if lzw$output$raw(code) = 0 then return 0;
            end;
        end;
        else if code = lzw$next$code and prev$code <> 0ffffh then do;
            fb = lzw$first$byte(prev$code);
            if with$rle then do;
                if lzw$output(prev$code) = 0 then return 0;
            end;
            else do;
                if lzw$output$raw(prev$code) = 0 then return 0;
            end;
            if with$rle then do;
                if rle$decode$byte(fb) = 0 then return 0;
            end;
            else do;
                if putbyte(fb) = 0 then return 0;
            end;
        end;
        else do;
            done = 1;
        end;

        if first$flag = 0 and prev$code <> 0ffffh and done = 0 then do;
            if lzw$next$code < 4096 then
                call lzw$add$entry(prev$code, fb);
        end;

        prev$code = code;
        first$flag = 0;
    end;

    return 1;
end arc$decomp$lzw56;

/* ARC method 8: LZW with variable codes (LSB first) */
arc$decomp$lzw8: procedure byte;
    declare (code, prev$code) address;
    declare (first$flag, done) byte;
    declare fb byte;
    declare max$code address;
    declare (codes$in$block, pad) byte;

    /* First byte is max bits */
    lzw$max$bits = getbyte;
    if lzw$max$bits < 9 or lzw$max$bits > 16 then
        lzw$max$bits = 12;

    call init$lzw;
    lzw$next$code = 257;  /* ARC uses 256 for clear, 257+ for dict */
    lzw$code$size = 9;
    call init$bits$lsb;
    call init$rle;

    prev$code = 0ffffh;
    first$flag = 1;
    done = 0;
    codes$in$block = 0;

    do while done = 0 and input$avail <> 0;
        code = read$bits$lsb(lzw$code$size);
        codes$in$block = codes$in$block + 1;

        if code = 256 then do;
            /* ARC packs codes eight at a time, so one block is
               LZW$CODE$SIZE bytes, and the encoder pads the block out before
               starting again at 9 bits.  Reading straight on takes the padding
               for data and loses the stream at the first code after the CLEAR.
               A code size increase needs no alignment: the increase happens
               after exactly 2**LZW$CODE$SIZE - 256 codes, which is a multiple
               of 8 for every code size from 9 up.  CODES$IN$BLOCK may wrap at
               256, and 256 is a multiple of 8, so wrapping does not disturb
               the count. */
            pad = (8 - (codes$in$block and 7)) and 7;
            do while pad <> 0;
                code = read$bits$lsb(lzw$code$size);
                pad = pad - 1;
            end;
            /* Clear code */
            call init$lzw;
            lzw$next$code = 257;
            lzw$code$size = 9;
            prev$code = 0ffffh;
            first$flag = 1;
            codes$in$block = 0;
        end;
        else do;
            if code < 256 then do;
                if rle$decode$byte(low(code)) = 0 then return 0;
                fb = low(code);
            end;
            else if code < lzw$next$code then do;
                fb = lzw$first$byte(code);
                if lzw$output(code) = 0 then return 0;
            end;
            else if code = lzw$next$code and prev$code <> 0ffffh then do;
                fb = lzw$first$byte(prev$code);
                if lzw$output(prev$code) = 0 then return 0;
                if rle$decode$byte(fb) = 0 then return 0;
            end;
            else do;
                done = 1;
            end;

            if first$flag = 0 and prev$code <> 0ffffh and done = 0 then do;
                if lzw$next$code < shl(double(1), lzw$max$bits) then do;
                    call lzw$add$entry(prev$code, fb);
                    /* Increase code size when needed */
                    max$code = shl(double(1), lzw$code$size) - 1;
                    if lzw$next$code > max$code and lzw$code$size < lzw$max$bits then
                        lzw$code$size = lzw$code$size + 1;
                end;
            end;

            prev$code = code;
            first$flag = 0;
        end;
    end;

    return 1;
end arc$decomp$lzw8;

/* ARC method 9: Squashed (13-bit LZW, LSB first, no RLE, no header) */
arc$decomp$squashed: procedure byte;
    declare (code, prev$code) address;
    declare (first$flag, done) byte;
    declare fb byte;
    declare max$code address;
    declare (codes$in$block, pad) byte;

    call init$lzw;
    lzw$next$code = 257;
    lzw$code$size = 9;
    lzw$max$bits = 13;
    call init$bits$lsb;

    prev$code = 0ffffh;
    first$flag = 1;
    done = 0;
    codes$in$block = 0;

    do while done = 0 and input$avail <> 0;
        code = read$bits$lsb(lzw$code$size);
        codes$in$block = codes$in$block + 1;

        if code = 256 then do;
            /* ARC packs codes eight at a time, so one block is
               LZW$CODE$SIZE bytes, and the encoder pads the block out before
               starting again at 9 bits.  Reading straight on takes the padding
               for data and loses the stream at the first code after the CLEAR.
               A code size increase needs no alignment: the increase happens
               after exactly 2**LZW$CODE$SIZE - 256 codes, which is a multiple
               of 8 for every code size from 9 up.  CODES$IN$BLOCK may wrap at
               256, and 256 is a multiple of 8, so wrapping does not disturb
               the count. */
            pad = (8 - (codes$in$block and 7)) and 7;
            do while pad <> 0;
                code = read$bits$lsb(lzw$code$size);
                pad = pad - 1;
            end;
            /* Clear */
            call init$lzw;
            lzw$next$code = 257;
            lzw$code$size = 9;
            prev$code = 0ffffh;
            first$flag = 1;
            codes$in$block = 0;
        end;
        else do;
            if code < 256 then do;
                if putbyte(low(code)) = 0 then return 0;
                fb = low(code);
            end;
            else if code < lzw$next$code then do;
                fb = lzw$first$byte(code);
                if lzw$output$raw(code) = 0 then return 0;
            end;
            else if code = lzw$next$code and prev$code <> 0ffffh then do;
                fb = lzw$first$byte(prev$code);
                if lzw$output$raw(prev$code) = 0 then return 0;
                if putbyte(fb) = 0 then return 0;
            end;
            else do;
                done = 1;
            end;

            if first$flag = 0 and prev$code <> 0ffffh and done = 0 then do;
                call lzw$add$entry(prev$code, fb);
                max$code = shl(double(1), lzw$code$size) - 1;
                if lzw$next$code > max$code and lzw$code$size < lzw$max$bits then
                    lzw$code$size = lzw$code$size + 1;
            end;

            prev$code = code;
            first$flag = 0;
        end;
    end;

    return 1;
end arc$decomp$squashed;

/*========================================================
 * ARC Archive Extraction
 *========================================================*/

/* Extract one ARC member */
extract$arc$member: procedure byte public;
    declare msg$method data('Unsupported ARC method$');
    declare (i, method) byte;
    declare (comp$size, orig$size) address;
    declare (comp$size$hi, orig$size$hi) address;  /* High words for 32-bit sizes */
    declare filename (14) byte;
    declare result byte;

    /* Read method byte */
    method = getbyte;
    if method = 0 then return 0;  /* End of archive */

    /* Read filename (13 bytes) */
    i = 0;
    do while i < 13;
        filename(i) = getbyte;
        i = i + 1;
    end;
    filename(13) = 0;

    /* Read compressed size (4 bytes LE) - full 32-bit value */
    comp$size = getbyte;
    comp$size = comp$size + shl(double(getbyte), 8);
    comp$size$hi = getbyte;
    comp$size$hi = comp$size$hi + shl(double(getbyte), 8);

    /* Read date/time (4 bytes, skip) */
    i = getbyte;
    i = getbyte;
    i = getbyte;
    i = getbyte;

    /* Read CRC (2 bytes, skip) */
    i = getbyte;
    i = getbyte;

    /* Read original size (4 bytes LE) for method >= 2 */
    if method >= 2 then do;
        orig$size = getbyte;
        orig$size = orig$size + shl(double(getbyte), 8);
        orig$size$hi = getbyte;
        orig$size$hi = orig$size$hi + shl(double(getbyte), 8);
    end;
    else do;
        orig$size = comp$size;
        orig$size$hi = comp$size$hi;
    end;

    /* Print filename */
    call printchar(' ');
    call printchar(' ');
    i = 0;
    do while filename(i) <> 0;
        call printchar(filename(i));
        i = i + 1;
    end;

    /* Set up output FCB with a name CP/M can take (names.plm).  An ARC name
       was often made on MS-DOS or Unix; this used to copy it as it stood, and
       a type of one or two letters put NULs into the FCB. */
    call cpm$name(.filename, 13);

    /* The member's data is the next COMP$SIZE$HI * 65536 + COMP$SIZE bytes,
       and the next header follows it, so every path below reads through the
       limit and no further. */
    call set$input$limit(comp$size, comp$size$hi);

    /* Create output file.  A member that cannot be created is skipped over:
       returning before its data left the next header unfound, so the members
       after it were lost. */
    call deletefile(ofcb$ptr);
    if makefile(ofcb$ptr) = 0ffh then do;
        call printstr(.(13, 10, 'Cannot create file$'));
        call crlf;
        call skip$input;
        call clear$input$limit;
        return 2;  /* Skip but continue */
    end;

    outbuf$pos = 0;
    result = 1;

    /* Decompress based on method */
    if method = 1 or method = 2 then do;
        /* Stored */
        result = arc$decomp$stored;
    end;
    else if method = 3 then do;
        /* Packed (RLE) */
        result = arc$decomp$rle;
    end;
    else if method = 4 then do;
        /* Squeezed */
        call init$bits$lsb;
        result = arc$decomp$squeezed;
    end;
    else if method = 5 then do;
        /* Old crunched (no RLE) */
        result = arc$decomp$lzw56(0);
    end;
    else if method = 6 then do;
        /* Old crunched + RLE */
        result = arc$decomp$lzw56(1);
    end;
    else if method = 7 or method = 8 then do;
        /* Crunched (newer LZW) */
        result = arc$decomp$lzw8;
    end;
    else if method = 9 then do;
        /* Squashed */
        result = arc$decomp$squashed;
    end;
    else do;
        call printstr(.(13, 10, '  $'));
        call printstr(.msg$method);
        call printchar(' ');
        call printhex(method);
        /* Skip the compressed data */
        call skip$input;
        call closefile(ofcb$ptr);
        call clear$input$limit;
        return 2;
    end;

    /* Skip any remaining bytes in compressed data */
    call skip$input;

    /* Reset input limit for next member */
    call clear$input$limit;

    /* Flush and close output */
    if result then
        result = flush$outbuf;
    call closefile(ofcb$ptr);

    if result then do;
        call printstr(.(' OK$'));
        file$count = file$count + 1;
        call crlf;
        return 1;
    end;

    /* The member would not decode, or its file would not take all of it.
       Its data has been read through all the same (skip$input above), so
       the next header is where it should be: go on to it, as src/un80 does.
       Returning 0 here ended the archive, and every member after this one
       was lost. */
    call printstr(.(13, 10, '  Error$'));
    call crlf;
    return 2;
end extract$arc$member;

/* Extract all files from ARC archive */
extract$arc: procedure byte public;
    declare result byte;
    declare b byte;

    file$count = 0;
    call clear$input$limit;  /* No limit when scanning for headers */

    do while input$avail;
        /* Check for ARC marker */
        b = peekbyte;
        if b <> arc$marker then
            return 1;  /* Done */

        b = getbyte;  /* Consume marker */
        b = peekbyte; /* Check method */
        if b = 0 then
            return 1;  /* End of archive */

        result = extract$arc$member;
        if result = 0 then return 0;  /* End of archive */
        /* Result = 2: the member was skipped or went wrong; go on */
    end;

    return 1;
end extract$arc;

eof
